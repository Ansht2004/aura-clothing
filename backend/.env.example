# ==============================================================================
# Aura Apparel - Backend Environment Configuration
# ==============================================================================

# Database Connection:
# 1. For SQLite (default out-of-the-box, no setup required):
# DATABASE_URL=sqlite:///aura_clothing.db

# 2. For MySQL with MySQL Workbench:
# Change 'YOUR_MYSQL_PASSWORD' below to your actual MySQL root password.
# (If your MySQL has NO password, leave it empty: mysql+pymysql://root:@localhost:3306/aura_clothing)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/aura_clothing

# Secret Keys
SECRET_KEY=aura-apparel-super-secure-jwt-secret-key-2026
JWT_SECRET_KEY=aura-apparel-jwt-token-key-2026-mca

# Server port
PORT=5000
FLASK_ENV=development
